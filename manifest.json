{
  "manifest_version": 3,
  "name": "TB · Tripo Blender",
  "version": "1.1.1",
  "description": "Download and convert Tripo GLB models for Blender.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting",
    "webRequest",
    "storage"
  ],
  "host_permissions": [
    "https://studio.tripo3d.ai/*",
    "https://tripo-data.rg1.data.tripo3d.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TB · Tripo Blender",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://studio.tripo3d.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
